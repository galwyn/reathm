# General ignores
.DS_Store
*.log
*.pyc
*.swp

# IDE specific files
.idea/
.vscode/
.atom/
.history/

# Flutter/Dart specific ignores
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
app.*.symbols
app.*.map.json

# Platform specific generated files
/ios/Flutter/.last_build_id
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/.gradle/
/windows/flutter/generated_plugins.cmake

# Firebase specific generated files and caches
.firebase/
lib/firebase_options.dart

# Node.js specific ignores (for functions/ directory)
/node_modules/
package-lock.json

# Sensitive files (should NEVER be committed)
/android/key.properties
/android/app/google-services.json
*.jks

# Generated log/session files
logcat_capture.txt
gemini_cli_session_log.md
